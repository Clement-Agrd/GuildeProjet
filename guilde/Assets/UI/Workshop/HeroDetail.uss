.profile-columns {
    flex-direction: row;
    align-items: stretch;
}

.profile-section {
    padding: 12px 14px;
    margin-bottom: 10px;
    background-color: #f3dbaf;
    border-width: 1px;
    border-color: #c49860;
    border-radius: 8px;
    min-width: 0;
}

.profile-left { flex-basis: 42%; margin-right: 10px; }
.profile-right { flex-basis: 0; flex-grow: 1; }

.profile-heading {
    color: #784610;
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.profile-grid { flex-direction: row; flex-wrap: wrap; }
.profile-field { width: 25%; padding: 0 6px 3px 0; }
.profile-secondary, .profile-empty-slot { color: #624528; font-size: 13px; white-space: normal; }
.profile-emphasis { color: #352216; font-size: 15px; -unity-font-style: bold; white-space: normal; }
.profile-state { color: #4c613a; font-size: 13px; margin: 4px 0; }

.profile-meter-row { flex-direction: row; align-items: center; margin-top: 3px; }
.profile-meter-label { width: 66px; flex-shrink: 0; font-size: 13px; color: #523622; }
.profile-meter { flex-grow: 1; flex-basis: 0; min-height: 17px; }
.profile-meter .unity-progress-bar__container { min-height: 17px; height: 17px; }
.profile-meter .unity-progress-bar__background { background-color: #62432b; border-width: 0; }
.profile-meter .unity-progress-bar__title { font-size: 11px; color: #ffffff; }
.profile-meter-moral .unity-progress-bar__progress { background-color: #4d8864; }
.profile-meter-fatigue .unity-progress-bar__progress { background-color: #9e663d; }
.profile-meter-loyalty .unity-progress-bar__progress { background-color: #645888; }
.profile-meter-xp .unity-progress-bar__progress { background-color: #357696; }

.profile-attribute, .profile-combat {
    flex-direction: row;
    align-items: center;
    min-height: 53px;
    padding: 3px 5px 3px 0;
}

.profile-attribute { width: 25%; }
.profile-combat { width: 33.3%; }
.profile-stat-icon {
    width: 38px;
    height: 43px;
    flex-shrink: 0;
    margin-right: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.profile-stat-text, .profile-job-text { flex-basis: 0; flex-grow: 1; min-width: 0; }
.profile-stat-value { color: #352216; font-size: 17px; -unity-font-style: bold; }
.profile-stat-label { color: #624528; font-size: 12px; white-space: normal; }
.profile-slot { width: 50%; min-height: 37px; padding: 2px 5px 3px 0; }
.profile-broken-slot { color: #923a22; }

.profile-job {
    width: 49%;
    margin-right: 1%;
    min-height: 43px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #c49860;
}

.profile-job Button { margin: 2px 4px 2px 8px; min-width: 76px; min-height: 28px; padding: 4px 8px; }
.job-performance { margin-top: 3px; margin-bottom: 5px; }
.job-effect-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 2px 4px; }
.job-effect-row > .profile-secondary { flex-shrink: 1; min-width: 0; }
.job-effect-row:hover, .job-effect-row:focus { background-color: #ecd7a4; }
.job-effect-value { color: #352216; font-size: 13px; -unity-font-style: bold; margin-left: 6px; white-space: normal; }
.job-effect-tooltip {
    position: absolute;
    display: none;
    white-space: normal;
    background-color: #332519;
    color: #ffe5b6;
    font-size: 14px;
    padding: 10px;
    border-width: 1px;
    border-color: #b98b54;
    border-radius: 4px;
}
.profile-trait { padding: 4px 0; }

.profile-stat-icon--Vitalite { background-image: url("HeroStats/Vitalite.png"); }
.profile-stat-icon--Resistance { background-image: url("HeroStats/Resistance.png"); }
.profile-stat-icon--Force { background-image: url("HeroStats/Force.png"); }
.profile-stat-icon--Intelligence { background-image: url("HeroStats/Intelligence.png"); }
.profile-stat-icon--Charisme { background-image: url("HeroStats/Charisme.png"); }
.profile-stat-icon--Sagesse { background-image: url("HeroStats/Sagesse.png"); }
.profile-stat-icon--Agilite { background-image: url("HeroStats/Agilite.png"); }
.profile-stat-icon--Chance { background-image: url("HeroStats/Chance.png"); }
.profile-stat-icon--PointsDeVie { background-image: url("HeroStats/PointsDeVie.png"); }
.profile-stat-icon--DefensePhysique { background-image: url("HeroStats/DefensePhysique.png"); }
.profile-stat-icon--DefenseMagique { background-image: url("HeroStats/DefenseMagique.png"); }
.profile-stat-icon--AttaquePhysique { background-image: url("HeroStats/AttaquePhysique.png"); }
.profile-stat-icon--AttaqueMagique { background-image: url("HeroStats/AttaqueMagique.png"); }
.profile-stat-icon--ChanceCrit { background-image: url("HeroStats/ChanceCrit.png"); }
.profile-stat-icon--DegatsCrit { background-image: url("HeroStats/DegatsCrit.png"); }
.profile-stat-icon--ResistanceCrit { background-image: url("HeroStats/ResistanceCrit.png"); }
.profile-stat-icon--Esquive { background-image: url("HeroStats/Esquive.png"); }
.profile-stat-icon--Precision { background-image: url("HeroStats/Precision.png"); }
.profile-stat-icon--PuissanceSoin { background-image: url("HeroStats/PuissanceSoin.png"); }
.profile-stat-icon--TauxRecuperation { background-image: url("HeroStats/TauxRecuperation.png"); }
